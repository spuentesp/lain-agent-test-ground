# Absolute paths to existing local clones. They are read-only inputs.
TAURI_SOURCE=/home/spuentesp/lain-test-workspace/tauri
PLUGINS_SOURCE=/home/spuentesp/lain-test-workspace/plugins-workspace

# Optional. Empty means timestamp plus a random suffix.
RUN_ID=

# One shared LAIN HTTP process is mandatory: separate stdio servers cannot
# coordinate claims with one another. Run only one harness on a port at a time.
LAIN_HTTP_PORT=9876

# Real post-agent checks, executed by the harness rather than trusted from agent prose.
# Tune these to the task so a run is affordable but meaningful.
TAURI_VERIFY_CMD=cargo test -p tauri convert_file_src
PLUGINS_VERIFY_CMD=cargo test -p tauri-plugin-window-state

# Prompts can be replaced with narrower issue-specific tasks. The defaults require
# substantive, test-backed work rather than comment-only edits.
TAURI_TASK=Inspect WebviewWindow file-URL conversion behavior, identify one concrete missing edge-case test or defect, implement the smallest justified improvement, and run the narrowest relevant tests.
PLUGINS_TASK=Inspect the window-state plugin restore/save behavior, identify one concrete missing edge-case test or defect, implement the smallest justified improvement, and run the narrowest relevant tests.

# Agent selection. Supported values: codex, claude, agy.
TAURI_AGENT=codex
PLUGINS_AGENT=agy
HOLDER_AGENT=codex
CONTENDER_AGENT=claude

# Optional model overrides. Empty uses each CLI's configured default.
CODEX_MODEL=
CLAUDE_MODEL=
AGY_MODEL=gemini-3.8-flash-medium

# ---------------------------------------------------------------------------
# Team-scenario battery (harness/run-battery.sh, harness/run-scenario.py)
# ---------------------------------------------------------------------------
# Agent pool. Roles are assigned round-robin per scenario so every scenario mixes
# different vendors. Override one role with e.g. S3_R_AGENT=kimi.
TEAM_AGENTS=codex,claude,agy,kimi,minimax

# Verification for tauri-only scenarios. tauri-utils needs no native GUI libraries.
TEAM_VERIFY_CMD=cargo test -p tauri-utils --lib

# What the shared LAIN server advertises to models. LAIN's default (`core`) HIDES
# register_agent/claim_files, and headless agents cannot refresh their tool list
# after `load_package`. The battery therefore advertises the coordination packages.
# Set to `core` to reproduce the out-of-the-box experience.
LAIN_TOOL_PROFILE=session,social,notes,federation

# Shared Rust build cache for all clones/runs (default: runs/.cargo-target).
# CARGO_TARGET_DIR=

# S6 (stdio state-lock probe) size.
S6_AGENTS=8
S6_ITERATIONS=3

# ---------------------------------------------------------------------------
# Agents other than codex/claude/agy: declare a command template.
# Placeholders (auto shell-quoted): @REPO@ @PROMPT_FILE@ @ENDPOINT@ @MODEL@ @RUN_DIR@ @ROLE@
# The command runs inside @REPO@, must read the prompt, use the LAIN MCP server at
# @ENDPOINT@ (streamable HTTP), run non-interactively with auto-approval, and exit.
# The lines below are TEMPLATES TO VERIFY against your installed CLIs, not facts.
# ---------------------------------------------------------------------------
# AGENT_CMD_KIMI=kimi --print --yolo --mcp-config '{"mcpServers":{"lain":{"url":"@ENDPOINT@"}}}' < @PROMPT_FILE@
# AGENT_CMD_MINIMAX=<your minimax CLI invocation> < @PROMPT_FILE@
# Agents with GLOBAL MCP config (not per invocation) can register hooks that run
# before/after each scenario; restore your original config in TEARDOWN.
# AGENT_SETUP_KIMI=kimi mcp add lain @ENDPOINT@
# AGENT_TEARDOWN_KIMI=kimi mcp remove lain
# AGENT_VERSION_KIMI=kimi --version
# KIMI_MODEL=
# MINIMAX_MODEL=
